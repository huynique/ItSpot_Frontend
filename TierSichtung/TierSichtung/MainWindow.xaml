<Window x:Class="TierSichtung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="Transparent"
        WindowState="Maximized"
        Icon="/assets/LogIn_Icon.png"
        Title=""
        Width="1200"
        Height="800"
        MinWidth="600">
    <!-- WindowState="Maximized"  sieht doof aus wegen bild-->


    <!-- Kein Window.Background mehr; wir schichten im Grid -->
    <Grid>
        <!-- (1) Unterste Ebene: Gradient -->
        <Rectangle Panel.ZIndex="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Opacity="1.0" Center="0.2,0.4">
                    <RadialGradientBrush.RelativeTransform>
                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="3.5" ScaleY="1.9"/>
                    </RadialGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFDBFFD6" Offset="0"/>
                    <GradientStop Color="#FFFFEDB1" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- (2) darüber: Hintergrundbild -->
        <Image Source="/assets/landscape.png"
               Panel.ZIndex="1"
               IsHitTestVisible="False" Stretch="UniformToFill" >
            <Image.OpacityMask>
                <ImageBrush ImageSource="/assets/landscape.png"/>
            </Image.OpacityMask>
        </Image>

        <!-- (3) ganz oben: deine Inhalte -->
        <Grid Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Suche -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label
                       Content="ItSpot"
                       FontSize="48"
                       FontWeight="Bold"
                       FontFamily="Goudy Std"
                       Foreground="#FFA6CB7E"
                       HorizontalAlignment="Left" Margin="29,0,0,0">
                    <Label.Effect>
                        <DropShadowEffect BlurRadius="5.5"
                                          ShadowDepth="3"
                                          Opacity="0.6" Direction="282"/>
                    </Label.Effect>
                </Label>



                <Button Grid.Column="2"
                        Content="LogIn"
                        FontSize="36"
                        FontFamily="Goudy Std"
                        HorizontalAlignment="Right"
                        Click="LoginClick"
                        Style="{StaticResource LoginHoverButton}" Foreground="#FFFFFDF0">
                    <Button.Effect>
                        <DropShadowEffect Color="#FFBDBB59" Direction="273" ShadowDepth="3" BlurRadius="5" Opacity="0.925"/>
                    </Button.Effect>
                </Button>
                <Button Grid.Column="2"
                    Content="About Us"
                    FontSize="26"
                    FontFamily="Goudy Std"
                    HorizontalAlignment="Right"
                    Click="AboutClick"
                    Style="{StaticResource LoginHoverButton}" Foreground="#FFFFFDF0" Margin="203,10,150,10" Width="197">
                    <Button.Effect>
                        <DropShadowEffect Color="#FFBDBB59" Direction="273" ShadowDepth="3" BlurRadius="5" Opacity="0.925"/>
                    </Button.Effect>
                </Button>
                <Button
                    Content="Post"
                    FontSize="26"
                    FontFamily="Goudy Std"
                    HorizontalAlignment="Center"
                    Click="PostClick"
                    Style="{StaticResource LoginHoverButton}" Foreground="#FFFFFDF0" Margin="0,0,0,0" Width="98" Grid.ColumnSpan="3">
                    <Button.Effect>
                        <DropShadowEffect Color="#FFBDBB59" Direction="273" ShadowDepth="3" BlurRadius="5" Opacity="0.925"/>
                    </Button.Effect>
                </Button>
            </Grid>

            <!-- SUCH- & FILTERBEREICH -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="50 40"
                        VerticalAlignment="Center">

                <TextBox x:Name="searchBox"
                         Width="177"
                         Height="30"
                         TextChanged="Search"
                         BorderBrush="{x:Null}"
                         SelectionBrush="#FFBDEE9B"
                         Background="White"
                         Style="{StaticResource RoundedTextBox}"
                         FontFamily="Goudy Std"
                         Foreground="#FF215814"
                         SelectionTextBrush="Black"/>

                <Button Width="30"
                        Height="30"
                        Margin="10,0"
                        Click="OpenFilter" BorderBrush="{x:Null}" Foreground="{x:Null}"
                        Style="{StaticResource FlatButton}"
                       
                        

                    >
                    <Button.Background>
                        <ImageBrush ImageSource="/assets/Custom-Icon-Design-Mono-General-4-Filter.512.png" Opacity="1"/>
                    </Button.Background>
                </Button>


                <ListBox x:Name="filterListe"
         BorderBrush="{x:Null}" Background="{x:Null}"
         SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- damit der ganze Zeilenbereich klickbar ist -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="GroupName" Value="Family"/>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding}"
                         IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                             Path=IsSelected, Mode=TwoWay}"
                         Checked="FilterChanged"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <!-- Items als einfache Strings; Template macht den Radio draus -->
                    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Mammal</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Bird</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Fish</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Reptile</sys:String>
                    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">(All)</sys:String>
                </ListBox>

            </StackPanel>

            <!-- CONTENT -->
            <ScrollViewer x:Name="scroll"
                          Grid.Row="2"
                          Margin="40"
                          VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="grid"
                             Columns="3"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Top"/>
            </ScrollViewer>
        </Grid>
        <Image Margin="641,233,52,84" Source="/assets/icon_itspot.png" Stretch="Uniform"/>
    </Grid>
</Window>
