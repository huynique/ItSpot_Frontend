<Window x:Class="TierSichtung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ItSpot"
        Width="1200"
        Height="800"
        MinWidth="600">

    <!-- Kein Window.Background mehr; wir schichten im Grid -->
    <Grid>
        <!-- (1) Unterste Ebene: Gradient -->
        <Rectangle Panel.ZIndex="0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Opacity="1.0">
                    <RadialGradientBrush.RelativeTransform>
                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="3.5" ScaleY="1.9"/>
                    </RadialGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFA0DF97" Offset="0"/>
                    <GradientStop Color="#FFFDEEBA" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- (2) darüber: Hintergrundbild -->
        <Image Source="/landscape.png"
               Panel.ZIndex="1"
               IsHitTestVisible="False" Stretch="UniformToFill" >
            <Image.OpacityMask>
                <ImageBrush ImageSource="/landscape.png"/>
            </Image.OpacityMask>
        </Image>

        <!-- (3) ganz oben: deine Inhalte -->
        <Grid Panel.ZIndex="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Suche -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="1"
                       Content="ItSpot"
                       FontSize="48"
                       FontWeight="Bold"
                       FontFamily="Goudy Std"
                       Foreground="#FF81BB41"
                       HorizontalAlignment="Center">
                    <Label.Effect>
                        <DropShadowEffect BlurRadius="5.5"
                                          ShadowDepth="3"
                                          Opacity="0.6" Direction="282"/>
                    </Label.Effect>
                </Label>

                <Button Grid.Column="2"
                        Content="LogIn"
                        FontSize="36"
                        FontFamily="Goudy Std"
                        HorizontalAlignment="Right"
                        Click="LoginClick"
                        Style="{StaticResource LoginHoverButton}" Foreground="#FFFFFDF0">
                    <Button.Effect>
                        <DropShadowEffect Color="#FFBDBB59" Direction="273" ShadowDepth="3" BlurRadius="5" Opacity="0.925"/>
                    </Button.Effect>
                </Button>
            </Grid>

            <!-- SUCH- & FILTERBEREICH -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="50 40"
                        VerticalAlignment="Center">

                <TextBox Width="177"
                         Height="30"
                         TextChanged="Search"
                         BorderBrush="{x:Null}"
                         SelectionBrush="#FFBDEE9B"
                         Background="White"
                         Style="{StaticResource RoundedTextBox}"
                         FontFamily="Goudy Std"
                         Foreground="#FF215814"
                         SelectionTextBrush="Black"/>

                <Button Width="30"
                        Height="30"
                        Margin="10,0"
                        Click="OpenFilter"/>

                <ListBox x:Name="filterListe" SelectionChanged="FilterChange">
                    <CheckBox Content="#Item1"/>
                    <CheckBox Content="#Item2"/>
                    <CheckBox Content="#Item3"/>
                </ListBox>
            </StackPanel>

            <!-- CONTENT -->
            <ScrollViewer x:Name="scroll"
                          Grid.Row="2"
                          Margin="40"
                          VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="grid"
                             Columns="3"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Top"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
